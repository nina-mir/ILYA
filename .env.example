# Local development database
DATABASE_URL=postgres://ilya:ilya_dev_password@localhost:5432/ilya_dev

# Auth/session values used from Phase 3 onward
SESSION_COOKIE_NAME=ilya_session
SESSION_SECRET=replace-this-with-a-long-random-string-before-production
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5

# Email mode used from Phase 3 onward.
# console = print login codes in the API terminal during local development.
# resend = send real login codes through Resend.
EMAIL_MODE=console
RESEND_API_KEY=
AUTH_FROM_EMAIL=Ilya <login@example.com>
