{
  "name": "ilya",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web,worker \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:worker": "npm exec -w apps/api -- tsx src/worker.ts",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w apps/api",
    "lint:notes": "echo \"No lint configured yet. Add ESLint later if desired.\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "db:check": "npm run db:check -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "test:kane:prepare": "tsx scripts/prepare-kane-suite.ts",
    "test:kane": "bash scripts/run-kane-suite.sh"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
